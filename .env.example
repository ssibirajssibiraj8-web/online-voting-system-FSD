# Database Configuration
# Default is SQLite for instant local zero-configuration execution.
# For Docker / PostgreSQL, use: postgresql://postgres:postgres@localhost:5432/voting_db
DATABASE_URL=sqlite:///./voting.db

# JWT Cryptographic Secrets
JWT_SECRET=super-secret-aethelgard-crypto-key-change-in-production-2026-xyz
JWT_REFRESH_SECRET=super-refresh-crypto-key-change-in-production-2026-xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1:3000

# Environment Mode
ENVIRONMENT=development

# Seed Credentials
SEED_ADMIN_EMAIL=admin@voting.system
SEED_ADMIN_PASSWORD=Admin@123456
SEED_MANAGER_EMAIL=manager@voting.system
SEED_MANAGER_PASSWORD=Manager@123456
SEED_VOTER_PASSWORD=Voter@123456
